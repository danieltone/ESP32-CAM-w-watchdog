# PlatformIO build artifacts
.pio/

# VS Code files that are auto-generated by PlatformIO and contain machine-specific
# absolute paths. Safe to delete — PlatformIO regenerates them automatically.
.vscode/c_cpp_properties.json
.vscode/launch.json

# Python cache
__pycache__/

# Log files (e.g. PlatformIO device monitor output)
logs/
*.log

# macOS metadata
.DS_Store

# VS Code workspace files
*.code-workspace